# CarbonGrader environment config. Copy to `.env` (gitignored) and fill in.
# Loaded by src/api/config.php. Never expose these to the browser.

# Google PageSpeed Insights API key (required for live results).
# Create: Google Cloud project -> enable "PageSpeed Insights API" -> create API key.
PAGESPEED_API_KEY=

# Default Lighthouse strategy: mobile | desktop
PSI_STRATEGY_DEFAULT=mobile

# Cache TTLs (seconds)
CACHE_TTL_PSI=43200
CACHE_TTL_GREENCHECK=172800

# Upstream HTTP timeout (seconds) — PSI can take 10-30s
HTTP_TIMEOUT_SECONDS=35

# Per-IP rate limit for job creation (requests per minute)
RATE_LIMIT_PER_MINUTE=10

# Writable, non-public working dir (cache/, jobs/, ratelimit/), relative to project root
VAR_DIR=var
